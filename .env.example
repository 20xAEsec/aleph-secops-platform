# Copy to .env.local and fill in. Without ANTHROPIC_API_KEY the app runs in demo mode
# (deterministic reports built from the same tool data), so it never breaks mid-demo.

# --- Claude (Anthropic API) ---
ANTHROPIC_API_KEY=
# Optional overrides. Reasoning model writes conclusions; fast model gathers and analyzes.
# ALEPH_MODEL_REASONING=claude-opus-5-5
# ALEPH_MODEL_FAST=claude-sonnet-5-5

# --- Vertex AI RAG Engine (knowledge base) ---
# Locally, auth uses Application Default Credentials: run `gcloud auth application-default login`.
# On Vercel, paste the service account's JSON key (one line) into GCP_SERVICE_ACCOUNT_KEY.
# GCP_SERVICE_ACCOUNT_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# Corpus id (e.g. 1234567890) or full name projects/<p>/locations/<l>/ragCorpora/<id>
VERTEX_RAG_CORPUS=
# VERTEX_RAG_TOP_K=6
