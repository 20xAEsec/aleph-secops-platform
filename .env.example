# Optional. The app needs NO env vars: it runs on seeded demo data (telemetry, intel, a demo
# knowledge base) and deterministic reports, locally and on Vercel.
# Fill these in .env.local only if you want to try the live integrations locally.

# --- Claude (Anthropic API) ---
# ANTHROPIC_API_KEY=
# ALEPH_MODEL_REASONING=claude-opus-5-5
# ALEPH_MODEL_FAST=claude-sonnet-5-5

# --- Vertex AI RAG Engine (replaces the demo knowledge base) ---
# Auth uses Application Default Credentials: run `gcloud auth application-default login`.
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
# VERTEX_RAG_CORPUS=
# VERTEX_RAG_TOP_K=6
